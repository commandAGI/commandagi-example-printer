# Copy this file to `.env` and fill in the values.

# Your CommandAGI device / operator API key ("cagi_…").
# Mint one in the app: Settings → API keys, or POST /me/api-keys.
CAGI_API_KEY=cagi_...

# API base URL. Leave as-is for production.
CAGI_API_BASE=https://api.commandagi.com

# The serial device your printer enumerates as.
#   Linux:   /dev/ttyUSB0  or  /dev/ttyACM0
#   macOS:   /dev/tty.usbserial-XXXX  or  /dev/tty.usbmodemXXXX
#   Windows: COM3
PRINTER_SERIAL_PORT=/dev/ttyUSB0

# Baud rate. The Ender 3 V3 SE default is 115200.
PRINTER_BAUD=115200

# A friendly name shown for the device.
PRINTER_NAME=Ender 3 V3 SE

# Where the printer physically lives (decimal degrees). Optional, but required to
# match against located "jobs near me". Omit both to run in register + report-only
# mode (no job matching).
PRINTER_LAT=
PRINTER_LNG=

# How far (meters) this printer will serve jobs from. A printer is stationary, so
# this is effectively the pool/region it belongs to.
SERVICE_RADIUS_M=25000
